library(ggplot2)
library(dplyr)
year_data <- dataset |>
group_by(release_year) |>
summarize(
mean_revenue = mean(revenue, na.rm = TRUE)
)
head(year_data)
ggplot(year_data, aes(x = release_year, y = mean_revenue, na.rm = TRUE)) +
geom_point() +
labs(
title = "scatterplot of average revenue ",
x = "years",
y = "average revenue per year"
)

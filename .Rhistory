year_data <- data.frame(
release_year = years,
mean_revenue = sapply(years, function(y) {
t.test(dataset$revenue[dataset$release_year == y])$estimate
}),
lower = sapply(years, function(y) {
t.test(dataset$revenue[dataset$release_year == y])$conf.int[1]
}),
upper = sapply(years, function(y) {
t.test(dataset$revenue[dataset$release_year == y])$conf.int[2]
})
)
